+-- UNISG HQ extension for WALO 1.6.11 (v0.8 two-squad-start experiment).
+-- Stock WALO owns the initial spawn and ownership tally; never seed on load.
+-- The addon is opt-in per NEW SAVE and completely inert in Story Mode.
+local UNISG_HQ_SMART = "jup_b208"
+local UNISG_HQ_SECTION = "isg_sim_squad_novice"
+local UNISG_HQ_SAVE_KEY = "walo_unisg_hq_native_v03" -- Keep old save marker unchanged!
+-- This Lua-only registration can outlive a saved-game change inside the process.
+-- Never leave jup_b208 marked as our HQ when loading a Story Mode save.
+local unisg_hq_registered_by_addon = false
+local function unisg_hq_reset_registration()
+    if not unisg_hq_registered_by_addon then return end
+    local sw = smart_terrain_warfare
+    -- Undo only our own addition; do not overwrite unrelated faction registrations.
+    if sw and sw.get_main_base_faction and sw.set_main_base
+       and sw.get_main_base_faction(UNISG_HQ_SMART) == "isg" then
+        sw.set_main_base(UNISG_HQ_SMART, nil)
+    end
+    unisg_hq_registered_by_addon = false
+end
+
+-- GAMMA saves the new-game Story checkbox in axr_main.config BEFORE
+-- fill_start_position(). It sets story_mode_disabled LATER, in
+-- ui_mm_faction_select.on_game_load(). Do not wait for the infoportion
+-- while performing the native new-game fill: it does not exist yet.
+local function unisg_hq_mode()
+    if not IsWarfare() then
+        return false, "warfare-off"
+    end
+    local cfg = axr_main and axr_main.config
+    local faction = cfg and cfg:r_value("character_creation", "new_game_faction", 3)
+    if faction and faction ~= "" then
+        -- A checked Story box is stored as true; unchecked is stored as nil.
+        -- Its presence is the authoritative initial choice before GAMMA
+        -- consumes and clears the transient new-game configuration.
+        if cfg:r_value("character_creation", "new_game_story_mode", 1) == true then
+            return false, "new-game-story-on"
+        end
+        return true, "new-game-story-off"
+    end
+    -- Ordinary saved-game load: the UI has consumed the menu choice, so
+    -- use the saved game infoportion AND WALO's normal Story check.
+    if has_alife_info("story_mode_disabled") and not IsStoryMode() then
+        return true, "saved-story-off"
+    end
+    return false, "story-on-or-choice-unresolved"
+end
+
+local function unisg_hq_enabled()
+    local enabled = unisg_hq_mode()
+    return enabled
+end
+
+local function unisg_hq_store()
+    return alife_storage_manager.get_state()
+end
+
+local function unisg_hq_smart()
+    return SIMBOARD and SIMBOARD.smarts_by_names and SIMBOARD.smarts_by_names[UNISG_HQ_SMART]
+end
+
+local function unisg_hq_capacity(smart)
+    -- bootstrap_smart copies smart.max_population to default_max_population
+    -- and then applies the stalker population multiplier. This raw value
+    -- therefore produces four EFFECTIVE slots after the normal WALO bootstrap.
+    local factor = tonumber(get_stalker_pop_factor()) or 1
+    if factor <= 0 then factor = 1 end
+    local raw_cap = 4 / factor
+    smart.default_max_population = raw_cap
+    smart.max_population = raw_cap
+    if smart.first_update then
+        smart_terrain_warfare.set_max_population(smart)
+    end
+    return raw_cap
+end
+
+-- UNISG HQ services: WALO already provisions trader and mechanic on jup_b208.
+-- Enable the two missing roles using its native uniqueness/respawn loop.
+-- Never spawn NPCs here; check_unique_npcs() counts existing role squads.
+local unisg_services_snapshot = nil
+
+local function unisg_services_enable()
+    local uniques = smart_terrain_warfare and smart_terrain_warfare.uniques
+    local slots = uniques and uniques[UNISG_HQ_SMART]
+    if type(slots) ~= "table" then
+        printf("[WALO UNISG services v0.8] SKIP: native slots unavailable")
+        return
+    end
+    if not unisg_services_snapshot or unisg_services_snapshot.slots ~= slots then
+        unisg_services_snapshot = {
+            slots = slots, medic = slots[3], barman = slots[4]
+        }
+    end
+    slots[3] = math.max(1, tonumber(slots[3]) or 0) -- medic
+    slots[4] = math.max(1, tonumber(slots[4]) or 0) -- barman
+    -- Role enablement is idempotent and intentionally has no per-load log spam.
+end
+
+-- A new Story Mode game can be loaded without restarting the process.
+-- Restore only the two slots this addon changed, leaving other mods intact.
+local function unisg_services_reset()
+    local previous = unisg_services_snapshot
+    if not previous then return end
+    local slots = previous.slots
+    if slots[3] == 1 then slots[3] = previous.medic end
+    if slots[4] == 1 then slots[4] = previous.barman end
+    unisg_services_snapshot = nil
+end
+
+local function unisg_hq_register()
+    local sw = smart_terrain_warfare
+    if not unisg_hq_registered_by_addon then
+        if sw.is_main_base and sw.is_main_base(UNISG_HQ_SMART) then
+            -- Another addon may own the role. Never overwrite an unknown entry:
+            -- WALO has no public API for reading all entry fields to restore it.
+            printf("[WALO UNISG native v0.8] HQ registration SKIP: another main_base entry exists")
+        else
+            sw.set_main_base(UNISG_HQ_SMART, {
+                faction = "isg", protect = false, resurrect = true
+            })
+            unisg_hq_registered_by_addon = true
+        end
+    end
+    unisg_services_enable()
+end
+
+-- Reconstruct transient HQ registration and capacity on loads of v0.3 saves.
+-- No squad is ever created here. Old saves have no opt-in marker.
+local function unisg_hq_restore()
+    if not unisg_hq_enabled() then return end
+    local st = unisg_hq_store()
+    if not (st and st[UNISG_HQ_SAVE_KEY]) then return end
+    local smart = unisg_hq_smart()
+    if not (smart and smart.props and smart.props.base > 0) then
+        printf("[WALO UNISG native v0.8] restore SKIP: smart unavailable")
+        return
+    end
+    unisg_hq_register()
+    unisg_hq_capacity(smart)
+    printf("[WALO UNISG native v0.8] restored HQ and capacity, no spawn")
+end
