+    -- UNISG HQ: two starting squads, processed inside the SAME WALO
+    -- fill_start_position() pass, before the normal owner-commit loop.
+    -- No DLTX change, story squad deletion, parallel spawner, or load-time spawn.
+    local unisg_enabled, unisg_mode_reason = unisg_hq_mode()
+    printf("[WALO UNISG native v0.8] start gate=%s reason=%s", tostring(unisg_enabled), unisg_mode_reason)
+    if unisg_enabled then
+        local st = unisg_hq_store()
+        local smart = unisg_hq_smart()
+        local faction_cfg = warfare_options.options.factions
+        local isg_cfg = faction_cfg and faction_cfg.isg
+        if not st then
+            printf("[WALO UNISG native v0.8] SKIP start: state unavailable")
+        elseif st[UNISG_HQ_SAVE_KEY] then
+            printf("[WALO UNISG native v0.8] SKIP start: save already marked")
+        elseif not (smart and smart.props and smart.props.base > 0) then
+            printf("[WALO UNISG native v0.8] SKIP start: smart unavailable or not a base")
+        elseif not (isg_cfg and isg_cfg.spawn_on_new_game) then
